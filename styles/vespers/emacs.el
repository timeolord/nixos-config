(set-frame-parameter nil 'alpha-background 100)
(set-face-attribute 'variable-pitch nil :family "EB Garamond" :height 1.2)
(set-face-attribute 'fixed-pitch nil :family "Terminus (TTF)" :height 1.0)
(set-face-attribute 'org-document-title nil :family "Cinzel" :height 1.7 :foreground "#d8bb78" :weight 'normal)
(set-face-attribute 'org-level-1 nil :family "Cinzel" :height 1.3 :foreground "#d8bb78" :weight 'normal)
(set-face-attribute 'org-level-2 nil :family "EB Garamond" :height 1.25 :foreground "#e8dfce")
(set-face-attribute 'org-level-3 nil :family "EB Garamond" :height 1.15 :foreground "#c9a45c")
(set-face-attribute 'mode-line nil :background "#453529" :foreground "#f2ebdd" :box '(:line-width 2 :color "#c9a45c" :style flat-button))
(set-face-attribute 'mode-line-inactive nil :background "#2e241d" :foreground "#b6a38b" :box nil)
(set-face-attribute 'vertical-border nil :foreground "#453529")
(setq-default line-spacing 0)
(setq doom-modeline-height 30)
(setq org-ellipsis " ▾")
