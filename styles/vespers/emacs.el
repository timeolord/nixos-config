(set-frame-parameter nil 'alpha-background 100)
(set-face-attribute 'variable-pitch nil :family "EB Garamond" :height 1.2)
(set-face-attribute 'fixed-pitch nil :family "@monospace_font@" :height 1.0)
(with-eval-after-load 'org-faces
  (set-face-attribute 'org-document-title nil :family "Cinzel" :height 1.7 :foreground "#@base0A@" :weight 'normal)
  (set-face-attribute 'org-level-1 nil :family "Cinzel" :height 1.3 :foreground "#@base0A@" :weight 'normal)
  (set-face-attribute 'org-level-2 nil :family "EB Garamond" :height 1.25 :foreground "#@base05@")
  (set-face-attribute 'org-level-3 nil :family "EB Garamond" :height 1.15 :foreground "#@base0D@"))
(with-eval-after-load 'doom-modeline
  (when (bound-and-true-p doom-modeline-mode) (doom-modeline-mode -1))
  (setq-default mode-line-format '("╞═ %* " mode-line-buffer-identification " ═╪═ " mode-name " ═╪═ %l:%c ═╪═ %p ═╡")))
(set-face-attribute 'mode-line nil :background "#@base01@" :foreground "#@base0A@" :box nil)
(set-face-attribute 'mode-line-inactive nil :background "#@base00@" :foreground "#@base04@" :box nil)
(set-face-attribute 'vertical-border nil :foreground "#@base02@")
(unless standard-display-table (setq standard-display-table (make-display-table)))
(set-display-table-slot standard-display-table 'vertical-border (make-glyph-code ?║))
(setq-default line-spacing 0)
(setq doom-modeline-height 30)
(setq org-ellipsis " ▾")
